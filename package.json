{
  "name": "mtgdraftfish",
  "version": "0.1.0",
  "private": true,
  "description": "Sealed-product expected value calculator for Magic: The Gathering booster boxes, with a target list, break-even odds and the Halftone visual identity.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "refresh": "tsx scripts/refresh.ts",
    "ev": "tsx scripts/ev.ts",
    "halftone:css": "tsx scripts/build-halftone-css.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
